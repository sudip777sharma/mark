{
  "restartable": "rs",
  "watch": [
    "src/main/java",
    "src/main/resources"
  ],
  "ext": "java,yml,yaml,properties,html,css,js",
  "ignore": [
    "src/test/**",
    "target/**",
    "node_modules/**",
    "ui/**",
    "mark-internal/**",
    "mark-workspace/**",
    ".git/**",
    ".vscode/**"
  ],
  "delay": 1500,
  "exec": "powershell -ExecutionPolicy Bypass -File .\\dev.ps1"
}
