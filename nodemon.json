{
  "restartable": "rs",
  "watch": [
    "src/main/java",
    "src/main/resources"
  ],
  "ext": "java,yml,yaml,properties",
  "ignore": [
    "src/test/**",
    "target/**",
    "ui/**",
    "mark-internal/**",
    "mark-workspace/**"
  ],
  "delay": 1500,
  "exec": ".\\mvnw.cmd spring-boot:run"
}
